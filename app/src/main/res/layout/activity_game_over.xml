<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.harvestrush.AnimatedGradientBackgroundView
        android:id="@+id/game_over_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/game_over_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@android:color/transparent">

        <com.example.harvestrush.CurvedJiggleTitleView
            android:id="@+id/title_curved"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Game Over Title" />

        <TextView
            android:id="@+id/tv_high_scores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 High Score: 0"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/score_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#55000000"
            android:layout_marginBottom="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_final_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Final Score: 0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Replaced fancy curved title with a clear button for Play Again -->
        <Button
            android:id="@+id/btn_play_again"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Play Again"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_back_menu"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:text="Main Menu" />

    </LinearLayout>
</FrameLayout>
