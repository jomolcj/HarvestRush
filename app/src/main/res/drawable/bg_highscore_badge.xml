<?xml version="1.0" encoding="utf-8"?>
<!-- Gold capsule badge background for High Score -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="40dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#FFF7D26A"
        android:centerColor="#FFF0B928"
        android:endColor="#FFE5A300" />
    <stroke
        android:width="2dp"
        android:color="#FFFFE7A8" />
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>

